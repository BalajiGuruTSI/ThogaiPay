<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ThogaiPay design tokens -->
    <Color x:Key="Primary">#0759D8</Color>
    <Color x:Key="PrimaryDark">#082B59</Color>
    <Color x:Key="PrimaryDarkText">#102A43</Color>
    <Color x:Key="Secondary">#00C2C7</Color>
    <Color x:Key="SecondaryDarkText">#102A43</Color>
    <Color x:Key="Tertiary">#FFB21A</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#102A43</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#082B59</Color>
    <Color x:Key="OffBlack">#102A43</Color>

    <Color x:Key="Gray100">#F7FAFF</Color>
    <Color x:Key="Gray200">#D7E2F3</Color>
    <Color x:Key="Gray300">#B8C7DF</Color>
    <Color x:Key="Gray400">#8EA4C4</Color>
    <Color x:Key="Gray500">#66799A</Color>
    <Color x:Key="Gray600">#4F617F</Color>
    <Color x:Key="Gray900">#102A43</Color>
    <Color x:Key="Gray950">#082B59</Color>

    <Color x:Key="Success">#168653</Color>
    <Color x:Key="Danger">#D92D20</Color>
    <Color x:Key="Warning">#B7791F</Color>

    <!-- Login page shared colors -->
    <Color x:Key="LoginPageBackground">#F5F8FE</Color>
    <Color x:Key="LoginHeaderOverlay">#002A69</Color>
    <Color x:Key="LoginTitleColor">#142D78</Color>
    <Color x:Key="LoginSecondaryTextColor">#6575A8</Color>
    <Color x:Key="LoginFieldBorderColor">#C8D4F2</Color>
    <Color x:Key="LoginFieldDividerColor">#D4DDF1</Color>
    <Color x:Key="LoginPlaceholderColor">#8997BF</Color>
    <Color x:Key="LoginFloatingLabelColor">#075BFF</Color>
    <Color x:Key="LoginFloatingLabelBackgroundColor">#FFFEFE</Color>
    <Color x:Key="LoginErrorColor">#C62828</Color>
    <Color x:Key="LoginOrDividerColor">#CDD8F1</Color>
    <Color x:Key="LoginGoogleBorderColor">#AABAF0</Color>
    <Color x:Key="LoginSecurityPanelBackgroundColor">#EEF8F6</Color>
    <Color x:Key="LoginSecurityIconBackgroundColor">#DDF7ED</Color>
    <Color x:Key="LoginSecurityTextColor">#079B58</Color>
    <Color x:Key="LoginLanguageChipBackgroundColor">#30FFFFFF</Color>
    <Color x:Key="LoginLanguageChipBorderColor">#80FFFFFF</Color>

    <!-- OTP page shared colors -->
    <Color x:Key="OtpHeaderOverlay">#001943</Color>
    <Color x:Key="OtpBackChipBackgroundColor">#F7FFFFFF</Color>
    <Color x:Key="OtpDigitActiveStrokeColor">#175CFF</Color>
    <Color x:Key="OtpDigitInactiveStrokeColor">#D4DCEE</Color>
    <Color x:Key="OtpResendLabelColor">#64739C</Color>
    <Color x:Key="OtpActionTextColor">#075BDE</Color>
    <Color x:Key="OtpSecurityPanelBackgroundColor">#EEF5FD</Color>
    <Color x:Key="OtpSecurityTextColor">#078B57</Color>
    <Color x:Key="OtpSecuritySubTextColor">#596B94</Color>

    <!-- Home/common shell colors -->
    <Color x:Key="HomeBottomBarStroke">#E3EAF5</Color>
    <Color x:Key="HomeBottomBarInactive">#66799A</Color>
    <Color x:Key="HomeBottomBarActive">#0759D8</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}"/>


    <Color x:Key="ThogaiPrimary">#0759D8</Color>
    <Color x:Key="ThogaiCyan">#19CDD5</Color>
    <Color x:Key="ThogaiNavy">#18356B</Color>
    <Color x:Key="ThogaiMuted">#66799A</Color>
    <Color x:Key="ThogaiBackground">#F4F8FF</Color>
    <Color x:Key="ThogaiSurface">#FFFFFF</Color>
    <Color x:Key="ThogaiBorder">#DCE7F6</Color>

    <Color x:Key="QuickRechargeSearchBackground">#FFFFFF</Color>
    <Color x:Key="QuickRechargeSearchBorder">#DCE8F7</Color>
    <Color x:Key="QuickRechargeSearchPlaceholder">#7583A0</Color>
    <Color x:Key="QuickRechargeSearchText">#14245B</Color>

</ResourceDictionary>