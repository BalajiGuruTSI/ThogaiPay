<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ThogaiPay.Controls"
             x:Class="ThogaiPay.MainPage"
             x:Name="RootPage"
             BackgroundColor="{StaticResource Gray100}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">

                <controls:AppBrandedHeader
    HeaderImageSource="header_home.png"
    LogoSource="thogaipay_mark_brand.svg"
    ShowBrand="False"
    ShowBackButton="False"
    ShowProfileButton="False"
    ProfileCommand="{Binding OpenProfileCommand}" />

                <controls:QuickRechargeSearchBar
                    Margin="10,-25"
    Text="{Binding SearchText, Mode=TwoWay}"
    Placeholder="Search mobile number or contact"
    SearchCommand="{Binding SearchCommand}"
    PickContactCommand="{Binding PickContactCommand}" />

                <!--<Border Margin="14,-90,14,0" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 22" Padding="16,14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Vanakkam!" FontSize="13" TextColor="{StaticResource Gray500}" />
                        <Label Text="Ready to recharge?" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Gray900}" />
                    </VerticalStackLayout>
                </Border>

                <Border Margin="14,14,14,0" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 22" Padding="14,14,14,14">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Quick Recharge" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource Gray900}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Border BackgroundColor="{StaticResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="38">
                                <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                                    <Image Source="mobile.svg" WidthRequest="14" HeightRequest="14" />
                                    <Label Text="Mobile" FontSize="14" FontAttributes="Bold" TextColor="White" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="#EEF4FC" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="38">
                                <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                                    <Image Source="dth.svg" WidthRequest="14" HeightRequest="14" />
                                    <Label Text="DTH" FontSize="14" TextColor="{StaticResource Gray900}" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <controls:FloatingLabelEntry LabelText="Mobile Number"
                                                     Placeholder="Enter mobile number"
                                                     IconSource="phone.svg"
                                                     Keyboard="Telephone"
                                                     MaxLength="10"
                                                     FieldHeight="48"
                                                     FieldCornerRadius="12"
                                                     FieldPadding="12,0"
                                                     FieldBorderColor="{StaticResource Gray200}"
                                                     FieldDividerColor="{StaticResource Gray200}"
                                                     LabelTextColor="{StaticResource Gray500}"
                                                     EntryPlaceholderColor="#9AA8BE" />

                        <controls:SwipeActionButton Text="Swipe to Continue"
                                                    ButtonHeight="52"
                                                    TextStyle="{StaticResource LoginPrimaryActionTextStyle}"
                                                    ActionCommand="{Binding Source={x:Reference RootPage}, Path=ContinueToRechargeCommand}"
                                                    IsBusy="{Binding Source={x:Reference RootPage}, Path=IsPrimaryActionBusy}">
                            <controls:SwipeActionButton.ButtonBackground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#14D3D8" Offset="0" />
                                    <GradientStop Color="#125CD8" Offset="1" />
                                </LinearGradientBrush>
                            </controls:SwipeActionButton.ButtonBackground>
                        </controls:SwipeActionButton>
                    </VerticalStackLayout>
                </Border>

                <Grid Margin="18,16,18,0" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label Text="Quick Favourites" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Gray900}" />
                    <Label Grid.Column="1" Text="View All" FontSize="12" TextColor="{StaticResource Primary}" VerticalOptions="End" />
                </Grid>

                <HorizontalStackLayout Margin="18,10,18,0" Spacing="18">
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Border WidthRequest="56" HeightRequest="56" BackgroundColor="#DFF3FF" StrokeThickness="0" StrokeShape="RoundRectangle 28">
                            <Image Source="heart.svg" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Athiyan" FontSize="12" HorizontalTextAlignment="Center" TextColor="{StaticResource Gray900}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Border WidthRequest="56" HeightRequest="56" BackgroundColor="#FDE8E7" StrokeThickness="0" StrokeShape="RoundRectangle 28">
                            <Image Source="heart.svg" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Family" FontSize="12" HorizontalTextAlignment="Center" TextColor="{StaticResource Gray900}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Border WidthRequest="56" HeightRequest="56" BackgroundColor="#E2F8F0" StrokeThickness="0" StrokeShape="RoundRectangle 28">
                            <Image Source="heart.svg" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Appa" FontSize="12" HorizontalTextAlignment="Center" TextColor="{StaticResource Gray900}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Border WidthRequest="56" HeightRequest="56" BackgroundColor="White" Stroke="{StaticResource Primary}" StrokeDashArray="3,3" StrokeShape="RoundRectangle 28">
                            <Image Source="plus.svg" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Add" FontSize="12" HorizontalTextAlignment="Center" TextColor="{StaticResource Gray900}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <Label Margin="18,16,18,0" Text="Recent Recharges" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Gray900}" HorizontalTextAlignment="Center" />

                <Border Margin="18,10,18,20" BackgroundColor="White" Stroke="#E3EAF5" StrokeShape="RoundRectangle 15" Padding="12,10">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border WidthRequest="30" HeightRequest="30" BackgroundColor="#E5F0FF" StrokeThickness="0" StrokeShape="RoundRectangle 15">
                            <Image Source="mobile.svg" WidthRequest="14" HeightRequest="14" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Mobile recharge" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Gray900}" />
                            <Label Text="••••• 3210 · Recent" FontSize="11" TextColor="{StaticResource Gray500}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="₹299" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Success}" VerticalOptions="Center" />
                    </Grid>
                </Border>-->
            </VerticalStackLayout>
        </ScrollView>
        <controls:SoftPillBottomBar Grid.Row="1" ActiveTab="Home" VerticalOptions="End"/>
    </Grid>
</ContentPage>
