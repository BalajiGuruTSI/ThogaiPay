<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ThogaiPay.Controls.AppBottomBar"
    x:Name="BottomRoot"
    HeightRequest="104"
    BackgroundColor="Transparent">

    <Grid Padding="8,0,8,4">

        <!-- Rounded white navigation surface; deliberately no shadow. -->
        <Border
            Margin="0,28,0,0"
            BackgroundColor="White"
            Stroke="#E5EEFA"
            StrokeThickness="0.5"
            StrokeShape="RoundRectangle 52">

            <Grid
                ColumnDefinitions="*,*,*,*,*"
                Padding="6,8,6,4"
                ColumnSpacing="0">

                <!-- Home -->
                <Grid Grid.Column="0">
                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="4">
                        <Image
                            Source="home.svg"
                            WidthRequest="25"
                            HeightRequest="25"
                            Opacity="{Binding Source={x:Reference BottomRoot},
                                Path=HomeTabIconOpacity}" />
                        <Label
                            Text="Home"
                            FontSize="12"
                            TextColor="{Binding Source={x:Reference BottomRoot},
                                Path=HomeTabColor}" />
                    </VerticalStackLayout>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={x:Reference BottomRoot},
                                Path=HomeCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>

                <!-- Recharge -->
                <Grid Grid.Column="1">
                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="4">
                        <Image
                            Source="mobile.svg"
                            WidthRequest="25"
                            HeightRequest="25"
                            Opacity="{Binding Source={x:Reference BottomRoot},
                                Path=RechargeTabIconOpacity}" />
                        <Label
                            Text="Recharge"
                            FontSize="12"
                            TextColor="{Binding Source={x:Reference BottomRoot},
                                Path=RechargeTabColor}" />
                    </VerticalStackLayout>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={x:Reference BottomRoot},
                                Path=RechargeCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>

                <!-- Reserved centre position -->
                <Grid Grid.Column="2" />

                <!-- History -->
                <Grid Grid.Column="3">
                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="4">
                        <Image
                            Source="history.svg"
                            WidthRequest="25"
                            HeightRequest="25"
                            Opacity="{Binding Source={x:Reference BottomRoot},
                                Path=HistoryTabIconOpacity}" />
                        <Label
                            Text="History"
                            FontSize="12"
                            TextColor="{Binding Source={x:Reference BottomRoot},
                                Path=HistoryTabColor}" />
                    </VerticalStackLayout>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={x:Reference BottomRoot},
                                Path=HistoryCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>

                <!-- Profile -->
                <Grid Grid.Column="4">
                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="4">
                        <Image
                            Source="profile.svg"
                            WidthRequest="25"
                            HeightRequest="25"
                            Opacity="{Binding Source={x:Reference BottomRoot},
                                Path=ProfileTabIconOpacity}" />
                        <Label
                            Text="Profile"
                            FontSize="12"
                            TextColor="{Binding Source={x:Reference BottomRoot},
                                Path=ProfileTabColor}" />
                    </VerticalStackLayout>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={x:Reference BottomRoot},
                                Path=ProfileCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Grid>
        </Border>

        <!-- Centre logo: no Border.Shadow and no elevation. -->
        <Border
            WidthRequest="82"
            HeightRequest="82"
            BackgroundColor="White"
            Stroke="#EAF1FB"
            StrokeThickness="0.5"
            StrokeShape="RoundRectangle 41"
            HorizontalOptions="Center"
            VerticalOptions="Start">

            <Border.GestureRecognizers>
                <TapGestureRecognizer
                    Command="{Binding Source={x:Reference BottomRoot},
                        Path=CenterCommand}" />
            </Border.GestureRecognizers>

            <Image
                Source="thogaipay_mark_brand.svg"
                WidthRequest="62"
                HeightRequest="62"
                Aspect="AspectFit"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Border>

    </Grid>
</ContentView>
