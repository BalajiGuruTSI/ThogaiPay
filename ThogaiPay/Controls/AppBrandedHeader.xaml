<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ThogaiPay.Controls.AppBrandedHeader"
    x:Name="HeaderRoot"
    HeightRequest="240"
    MinimumHeightRequest="200"
    HorizontalOptions="Fill"
    VerticalOptions="Start"
    IsClippedToBounds="True">

    <Grid RowDefinitions="*" RowSpacing="0">

        <!-- Scenic Tamil Nadu background -->
        <Image
            Source="vpm_bg.png"
            Aspect="AspectFill"
            HorizontalOptions="Fill"
            VerticalOptions="Fill" />

        <!-- Light overlay improves white text readability -->
        <BoxView InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush
                    StartPoint="0,0"
                    EndPoint="0,1">
                    <GradientStop Color="#50102D65" Offset="0.0" />
                    <GradientStop Color="#20102D65" Offset="0.55" />
                    <GradientStop Color="#00102D65" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Header content -->
        <Grid
            Padding="20,44,20,42"
            RowDefinitions="Auto,*"
            RowSpacing="0">

            <Grid
                ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="11"
                VerticalOptions="Start">

                <!-- ThogaiPay logo -->
                <Image
                    Grid.Column="0"
                    Source="thogaipay_mark.png"
                    WidthRequest="46"
                    HeightRequest="46"
                    Aspect="AspectFit"
                    VerticalOptions="Center" />

                <!-- Brand name and Tamil tagline -->
                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="3"
                    VerticalOptions="Center">

                    <HorizontalStackLayout Spacing="0">
                        <Label
                            Text="{Binding Source={x:Reference HeaderRoot},
                                           Path=TitleText}"
                            FontSize="23"
                            FontFamily="OpenSansSemibold"
                            TextColor="White"
                            LineBreakMode="NoWrap"
                            VerticalOptions="Center" />

                        <Label
                            Text="{Binding Source={x:Reference HeaderRoot},
                                           Path=AccentTitleText}"
                            FontSize="23"
                            FontFamily="OpenSansSemibold"
                            TextColor="#35E6FF"
                            LineBreakMode="NoWrap"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Label
                        Text="{Binding Source={x:Reference HeaderRoot},
                                       Path=SubtitleText}"
                        FontSize="11"
                        FontFamily="OpenSansRegular"
                        TextColor="White"
                        Opacity="0.96"
                        LineBreakMode="TailTruncation"
                        MaxLines="2" />

                </VerticalStackLayout>

                <!-- Profile button -->
                <Border
                    Grid.Column="2"
                    IsVisible="{Binding Source={x:Reference HeaderRoot},
                                        Path=ShowProfileButton}"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="#F7FFFFFF"
                    Stroke="#45FFFFFF"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 22"
                    VerticalOptions="Center">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={x:Reference HeaderRoot},
                                              Path=ProfileCommand}" />
                    </Border.GestureRecognizers>

                    <Image
                        Source="profile.svg"
                        WidthRequest="22"
                        HeightRequest="22"
                        Aspect="AspectFit"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

            </Grid>
        </Grid>

        <!-- Curved lower transition.
             The rounded shape intentionally stays flat: no elevation/shadow. -->
        <Border
            VerticalOptions="End"
            HorizontalOptions="Fill"
            HeightRequest="26"
            Margin="0,0,0,-1"
            BackgroundColor="{AppThemeBinding Light=#F4F8FF,
                                              Dark=#101827}"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 26,26,0,0"
            InputTransparent="True" />

    </Grid>
</ContentView>
