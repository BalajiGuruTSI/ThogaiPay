<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ThogaiPay.Controls.QuickRechargeSearchBar"
             x:Name="SearchRoot"
             HeightRequest="58">
    <Border BackgroundColor="{StaticResource QuickRechargeSearchBackground}"
            Stroke="{StaticResource QuickRechargeSearchBorder}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 29"
            Padding="16,0">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Image Source="search_icon.png" WidthRequest="30" HeightRequest="30"
                   VerticalOptions="Center" />
            <Entry x:Name="SearchEntry" Grid.Column="1"
                   Text="{Binding Source={x:Reference SearchRoot}, Path=Text, Mode=TwoWay}"
                   Placeholder="{Binding Source={x:Reference SearchRoot}, Path=Placeholder}"
                   PlaceholderColor="{StaticResource QuickRechargeSearchPlaceholder}"
                   TextColor="{StaticResource QuickRechargeSearchText}"
                   FontSize="15" FontFamily="OpenSansRegular"
                   BackgroundColor="Transparent"
                   ClearButtonVisibility="WhileEditing"
                   ReturnType="Search"
                   ReturnCommand="{Binding Source={x:Reference SearchRoot}, Path=SearchCommand}"
                   VerticalOptions="Center" />
            <Border Grid.Column="2" WidthRequest="38" HeightRequest="38"
                    BackgroundColor="Transparent" StrokeThickness="0"
                    StrokeShape="RoundRectangle 19" VerticalOptions="Center">
                <Image Source="pick_contact_icon.png" WidthRequest="30" HeightRequest="30"
                       HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Source={x:Reference SearchRoot}, Path=PickContactCommand}" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>
    </Border>
</ContentView>
