<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ThogaiPay.Controls.SoftPillBottomBar"
    x:Name="BarRoot"
    HeightRequest="94"
    MinimumHeightRequest="94">

    <Grid Padding="12,0,12,4">
        <!-- Main pill: deliberately no shadow/elevation -->
        <Border
            Margin="0,16,0,0"
            HeightRequest="70"
            BackgroundColor="White"
            Stroke="#E5EDF8"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 35"
            VerticalOptions="Start">

            <Grid
                Padding="8,5"
                ColumnDefinitions="*,*,72,*,*"
                ColumnSpacing="2">

                <!-- Home -->
                <Grid Grid.Column="0" VerticalOptions="Fill" Padding="2">
                    <Border
                        BackgroundColor="{Binding Source={x:Reference BarRoot}, Path=HomeBackground}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 25"
                        Padding="4,5">
                        <VerticalStackLayout InputTransparent="True" Spacing="2" VerticalOptions="Center" HorizontalOptions="Center">
                            <Image Source="home.svg"
                                   WidthRequest="23" HeightRequest="23"
                                   Opacity="{Binding Source={x:Reference BarRoot}, Path=HomeOpacity}" />
                            <Label Text="Home" FontSize="11"
                                   FontFamily="OpenSansRegular"
                                   TextColor="{Binding Source={x:Reference BarRoot}, Path=HomeColor}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference BarRoot}, Path=HomeCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <!-- Recharge -->
                <Grid Grid.Column="1" VerticalOptions="Fill" Padding="2">
                    <Border
                        BackgroundColor="{Binding Source={x:Reference BarRoot}, Path=RechargeBackground}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 25"
                        Padding="4,5">
                        <VerticalStackLayout InputTransparent="True" Spacing="2" VerticalOptions="Center" HorizontalOptions="Center">
                            <Image Source="mobile.svg"
                                   WidthRequest="23" HeightRequest="23"
                                   Opacity="{Binding Source={x:Reference BarRoot}, Path=RechargeOpacity}" />
                            <Label Text="Recharge" FontSize="11"
                                   FontFamily="OpenSansRegular"
                                   TextColor="{Binding Source={x:Reference BarRoot}, Path=RechargeColor}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference BarRoot}, Path=RechargeCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <!-- Reserved space beneath the floating logo -->
                <Grid Grid.Column="2" />

                <!-- History -->
                <Grid Grid.Column="3" VerticalOptions="Fill" Padding="2">
                    <Border
                        BackgroundColor="{Binding Source={x:Reference BarRoot}, Path=HistoryBackground}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 25"
                        Padding="4,5">
                        <VerticalStackLayout InputTransparent="True" Spacing="2" VerticalOptions="Center" HorizontalOptions="Center">
                            <Image Source="history.svg"
                                   WidthRequest="23" HeightRequest="23"
                                   Opacity="{Binding Source={x:Reference BarRoot}, Path=HistoryOpacity}" />
                            <Label Text="History" FontSize="11"
                                   FontFamily="OpenSansRegular"
                                   TextColor="{Binding Source={x:Reference BarRoot}, Path=HistoryColor}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference BarRoot}, Path=HistoryCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <!-- Profile -->
                <Grid Grid.Column="4" VerticalOptions="Fill" Padding="2">
                    <Border
                        BackgroundColor="{Binding Source={x:Reference BarRoot}, Path=ProfileBackground}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 25"
                        Padding="4,5">
                        <VerticalStackLayout InputTransparent="True" Spacing="2" VerticalOptions="Center" HorizontalOptions="Center">
                            <Image Source="profile.svg"
                                   WidthRequest="23" HeightRequest="23"
                                   Opacity="{Binding Source={x:Reference BarRoot}, Path=ProfileOpacity}" />
                            <Label Text="Profile" FontSize="11"
                                   FontFamily="OpenSansRegular"
                                   TextColor="{Binding Source={x:Reference BarRoot}, Path=ProfileColor}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference BarRoot}, Path=ProfileCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Centre logo: Home shortcut, no shadow/elevation -->
        <Border
            WidthRequest="68"
            HeightRequest="68"
            BackgroundColor="White"
            Stroke="#E5EDF8"
            StrokeThickness="3"
            StrokeShape="RoundRectangle 34"
            HorizontalOptions="Center"
            VerticalOptions="Start">
            <Image
                Source="thogaipay_mark_brand.svg"
                WidthRequest="46"
                HeightRequest="46"
                Aspect="AspectFit"
                InputTransparent="True"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding Source={x:Reference BarRoot}, Path=HomeCommand}" />
            </Border.GestureRecognizers>
        </Border>
    </Grid>
</ContentView>
