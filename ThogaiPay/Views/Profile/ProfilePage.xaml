<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ThogaiPay.Controls"
             x:Class="ThogaiPay.Views.Profile.ProfilePage"
             BackgroundColor="{StaticResource Gray100}"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*" RowSpacing="0">
        <controls:AppBrandedHeader ShowProfileButton="False" />

        <Border Grid.Row="1"
                Margin="14,-86,14,16"
                Padding="18"
                BackgroundColor="White"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 22">
            <VerticalStackLayout Spacing="10">
                <Label Text="Profile"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Gray900}" />
                <Label Text="Profile settings and account preferences will be completed in the next phase."
                       FontSize="14"
                       TextColor="{StaticResource Gray500}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
