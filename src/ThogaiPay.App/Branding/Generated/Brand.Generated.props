<Project>
  <!-- Generated by tools/branding/brand.py. Do not edit by hand. -->
  <PropertyGroup>
    <ApplicationTitle>ThogaiPay</ApplicationTitle>
    <ApplicationId>in.thogaipay.app</ApplicationId>
    <BrandId>thogaipay</BrandId>
    <BrandUrlScheme>thogaipay</BrandUrlScheme>
    <BrandSplashColor>#FFFFFF</BrandSplashColor>
    <BrandDefaultLocale>en-IN</BrandDefaultLocale>
    <BrandSupportedLocales>en-IN;ta-IN</BrandSupportedLocales>
  </PropertyGroup>
  <ItemGroup>
    <MauiIcon Remove="Resources\AppIcon\thogaiappicon.png" />
    <MauiIcon Remove="Resources\AppIcon\appicon.svg" />
    <MauiIcon Include="Branding\Generated\brand_app_icon.png" />
    <MauiSplashScreen Remove="Resources\Splash\splash.svg" />
    <MauiSplashScreen Include="Branding\Generated\brand_splash.svg" Color="$(BrandSplashColor)" BaseSize="128,128" />
  </ItemGroup>
</Project>
