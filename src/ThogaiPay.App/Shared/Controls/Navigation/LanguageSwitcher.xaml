<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ThogaiPay.App.Shared.Controls.Navigation.LanguageSwitcher"
             x:Name="Root"
             SemanticProperties.Description="Choose application language">
    <!-- Compact segmented switch: intentionally no dropdown or chevron. -->
    <Border BackgroundColor="#F7FAFF"
            Stroke="#B9C7DC"
            StrokeThickness="1.3"
            Padding="4"
            StrokeShape="RoundRectangle 26"
            HorizontalOptions="End">
        <Grid ColumnDefinitions="Auto,Auto"
              ColumnSpacing="2">
            <Border x:Name="EnglishSegment"
                    Padding="13,8"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 22"
                    BackgroundColor="White">
                <Label x:Name="EnglishLabel"
                       Text="English"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource BrandPrimary}"
                       VerticalOptions="Center"
                       HorizontalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnEnglishTapped" />
                </Border.GestureRecognizers>
            </Border>

            <Border x:Name="TamilSegment"
                    Grid.Column="1"
                    Padding="13,8"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 22"
                    BackgroundColor="Transparent">
                <Label x:Name="TamilLabel"
                       Text="தமிழ்"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource BrandPrimary}"
                       VerticalOptions="Center"
                       HorizontalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTamilTapped" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>
    </Border>
</ContentView>
