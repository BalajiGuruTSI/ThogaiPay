<?xml version="1.0" encoding="UTF-8" ?>
<!-- Brand colors are generated into Branding/Generated/BrandResources.xaml. Keep neutral/semantic brand values out of this file. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ThogaiPay.App.Resources.Styles.Colors">
    <!-- Reserved for non-brand-specific neutral resources only. -->

    <!-- Unified CTA design tokens: update these resources to rebrand all shared actions. -->
    <SolidColorBrush x:Key="CTAPrimarySolidBrush" Color="#101F50" />
    <SolidColorBrush x:Key="CTAPrimaryForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CTASecondaryForeground" Color="#101F50" />
    <SolidColorBrush x:Key="CTATextForeground" Color="#2563EB" />
    <SolidColorBrush x:Key="CTARechargeForeground" Color="#101F50" />
    <SolidColorBrush x:Key="CTADestructiveForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CTASecondaryBorderBrush" Color="#101F50" />
    <SolidColorBrush x:Key="CTASurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CTATransparentBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="CTAAccentBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="CTARechargeBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="CTARechargeAccentBrush" Color="#D97706" />
    <SolidColorBrush x:Key="CTADestructiveBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="CTAPrimaryBorder" Color="#101F50" />
    <LinearGradientBrush x:Key="CTAPrimaryGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0759B8" Offset="0.0" />
        <GradientStop Color="#07347F" Offset="0.52" />
        <GradientStop Color="#071F59" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>
