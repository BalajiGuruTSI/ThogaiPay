<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:buttons="clr-namespace:ThogaiPay.App.Shared.Controls.Buttons"
    xmlns:inputs="clr-namespace:ThogaiPay.App.Shared.Controls.Inputs"
    xmlns:navigation="clr-namespace:ThogaiPay.App.Shared.Controls.Navigation"
    x:Class="ThogaiPay.App.Features.Auth.Views.LoginPage"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="Transparent">

    <Grid x:Name="PageRoot"
          RowSpacing="0"
          IsClippedToBounds="True">
        <!-- The approved wave artwork is a local asset and stays behind all page content. --><!--
        <Image Source="app_page_background.png"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"
               InputTransparent="True"
               SemanticProperties.Description="ThogaiPay blue and orange wave background" />-->

        <ScrollView VerticalScrollBarVisibility="Never"
                    HorizontalScrollBarVisibility="Never">
            <Grid Padding="24,12,24,20"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  RowSpacing="0"
                  HorizontalOptions="Fill"
                  WidthRequest="-1">

                <navigation:LanguageSwitcher x:Name="LanguageSwitcher"
                    Grid.Row="0"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="0,0,0,2"
                    SemanticProperties.Description="Switch application language" />

                <Image Grid.Row="1"
                       Source="brandlogo.png"
                       HeightRequest="112"
                       Aspect="AspectFit"
                       HorizontalOptions="Fill"
                       Margin="0,8,0,8"
                       SemanticProperties.Description="ThogaiPay logo and Tamil tagline" />

                <Image Grid.Row="2"
                       Source="login_security_illustration.png"
                       HeightRequest="166"
                       Aspect="AspectFit"
                       HorizontalOptions="Fill"
                       Margin="0,4,0,8"
                       SemanticProperties.Description="Secure mobile login illustration" />

                <VerticalStackLayout Grid.Row="3"
                                     Spacing="3"
                                     HorizontalOptions="Fill"
                                     Margin="0,4,0,18">
                    <Label Text="{Binding WelcomeTitle}"
                           FontSize="27"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource BrandPrimary}"
                           HorizontalTextAlignment="Center"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="{Binding LoginSubtitle}"
                           FontSize="13"
                           TextColor="{DynamicResource TextSecondary}"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="4" Spacing="7" Margin="0,0,0,14">
                    <inputs:FloatingLabelEntry
                        x:Name="MobileNumberEntry"
                        LabelText="{Binding MobileFieldLabel}"
                        PlaceholderText="{Binding MobilePlaceholder}"
                        Text="{Binding MobileNumber, Mode=TwoWay}"
                        InputKeyboard="Telephone"
                        MaxLength="10"
                        LeadingIcon="mobile_phone_icon_entry.png"
                        EntryReturnType="Go"
                        ReturnCommand="{Binding ContinueCommand}"
                        AutomationId="LoginMobileNumber" />
                    <Label Text="{Binding Message}"
                           IsVisible="{Binding HasMessage}"
                           TextColor="{Binding MessageColor}"
                           FontSize="12"
                           Margin="8,0,8,0" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="5" Spacing="14" Margin="0,0,0,12">
                    <buttons:CTAButton
                        Text="{Binding ContinueText}"
                        BusyText="{Binding ContinueBusyText}"
                        Command="{Binding ContinueCommand}"
                        IsBusy="{Binding IsContinuing}"
                        Variant="BrandedPrimary"
                        TrailingIcon="→"
                        HeightRequest="58"
                        AccessibilityLabel="Continue with mobile number"
                        AccessibilityHint="Validate the mobile number to request an OTP."
                        AutomationIdentifier="Login_GetOtp" />

                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="14" Margin="12,0">
                        <BoxView Grid.Column="0" HeightRequest="1" Color="{DynamicResource BorderDefault}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding OrText}" FontSize="16" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" />
                        <BoxView Grid.Column="2" HeightRequest="1" Color="{DynamicResource BorderDefault}" VerticalOptions="Center" />
                    </Grid>

                    <buttons:CTAButton
                        Text="{Binding CreateAccountText}"
                        Command="{Binding CreateAccountCommand}"
                        Variant="Secondary"
                        LeadingIconSource="user_plus.svg"
                        HeightRequest="54"
                        AccessibilityLabel="Create a new ThogaiPay account"
                        AutomationIdentifier="Login_CreateAccount" />
                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Row="6"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Spacing="8"
                                       Margin="0,0,0,4">
                    <Label Text="✓"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource StatusSuccess}"
                           VerticalOptions="Center" />
                    <Label Text="{Binding TrustText}"
                           FontSize="13"
                           TextColor="{DynamicResource TextSecondary}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
