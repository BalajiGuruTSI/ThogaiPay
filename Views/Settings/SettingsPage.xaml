<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="ThogaiPay.Views.Settings.SettingsPage" Title="Settings" BackgroundColor="#F5F7FB" Shell.NavBarIsVisible="False">
 <ScrollView><VerticalStackLayout Padding="20,24,20,30" Spacing="18">
  <Grid ColumnDefinitions="48,*" ColumnSpacing="12"><Border WidthRequest="44" HeightRequest="44" BackgroundColor="White" Stroke="#E4EAF3" StrokeShape="RoundRectangle 22"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBackTapped" /></Border.GestureRecognizers><Label Text="‹" FontSize="30" TextColor="#0759D8" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2"><Label Text="Settings" FontSize="27" FontAttributes="Bold" TextColor="#101828"/><Label Text="Customize your ThogaiPay experience" FontSize="13" TextColor="#667085"/></VerticalStackLayout></Grid>
  <Border Padding="16" BackgroundColor="White" Stroke="#E4EAF3" StrokeShape="RoundRectangle 22"><VerticalStackLayout Spacing="14">
   <Label Text="PREFERENCES" FontSize="12" FontAttributes="Bold" TextColor="#667085"/>
   <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12"><Border WidthRequest="40" HeightRequest="40" BackgroundColor="#E7F2FF" StrokeThickness="0" StrokeShape="RoundRectangle 20"><Label Text="文" TextColor="#0759D8" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2"><Label Text="Language" FontSize="16" FontAttributes="Bold" TextColor="#101828"/><Label Text="Choose your preferred language" FontSize="12" TextColor="#667085"/></VerticalStackLayout><Picker x:Name="LanguagePicker" Grid.Column="2" WidthRequest="105" Title="English" FontSize="13" ItemsSource="{Binding Languages}" SelectedIndex="0"/></Grid>
   <BoxView HeightRequest="1" BackgroundColor="#EEF1F6"/>
   <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12"><Border WidthRequest="40" HeightRequest="40" BackgroundColor="#FFE8EF" StrokeThickness="0" StrokeShape="RoundRectangle 20"><Label Text="♧" TextColor="#E83E70" FontSize="21" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2"><Label Text="Recharge updates" FontSize="16" FontAttributes="Bold" TextColor="#101828"/><Label Text="Status and confirmations" FontSize="12" TextColor="#667085"/></VerticalStackLayout><Switch Grid.Column="2" IsToggled="True" OnColor="#0759D8"/></Grid>
   <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12"><Border WidthRequest="40" HeightRequest="40" BackgroundColor="#FFF0D9" StrokeThickness="0" StrokeShape="RoundRectangle 20"><Label Text="％" TextColor="#D97706" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2"><Label Text="Offers &amp; discounts" FontSize="16" FontAttributes="Bold" TextColor="#101828"/><Label Text="Plans and special offers" FontSize="12" TextColor="#667085"/></VerticalStackLayout><Switch Grid.Column="2" IsToggled="True" OnColor="#0759D8"/></Grid>
  </VerticalStackLayout></Border>
  <Border Padding="16" BackgroundColor="White" Stroke="#E4EAF3" StrokeShape="RoundRectangle 22"><VerticalStackLayout Spacing="14"><Label Text="SECURITY &amp; PRIVACY" FontSize="12" FontAttributes="Bold" TextColor="#667085"/>
   <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12"><Border WidthRequest="40" HeightRequest="40" BackgroundColor="#DDF8E9" StrokeThickness="0" StrokeShape="RoundRectangle 20"><Label Text="✓" TextColor="#119B5A" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2"><Label Text="Biometric login" FontSize="16" FontAttributes="Bold" TextColor="#101828"/><Label Text="Use device biometrics to sign in" FontSize="12" TextColor="#667085"/></VerticalStackLayout><Switch Grid.Column="2" IsToggled="False" OnColor="#0759D8"/></Grid>
   <BoxView HeightRequest="1" BackgroundColor="#EEF1F6"/><Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12"><Border WidthRequest="40" HeightRequest="40" BackgroundColor="#F0E8FF" StrokeThickness="0" StrokeShape="RoundRectangle 20"><Label Text="⌑" TextColor="#7A3FF2" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2"><Label Text="Privacy policy" FontSize="16" FontAttributes="Bold" TextColor="#101828"/><Label Text="Review how your data is handled" FontSize="12" TextColor="#667085"/></VerticalStackLayout><Label Grid.Column="2" Text="›" FontSize="25" TextColor="#667085" VerticalOptions="Center"/></Grid>
  </VerticalStackLayout></Border>
  <Label Text="ThogaiPay • Version 1.0.0" HorizontalOptions="Center" FontSize="12" TextColor="#98A2B3"/>
 </VerticalStackLayout></ScrollView>
</ContentPage>